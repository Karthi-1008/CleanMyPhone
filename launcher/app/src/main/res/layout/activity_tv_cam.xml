<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Camera Preview Surface -->
    <SurfaceView
        android:id="@+id/cameraSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Screen Dim Overlay (for power saving while streaming) -->
    <LinearLayout
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📹 TV Camera is Streaming"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDimUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://192.168.0.7:8080"
            android:textColor="#00B0FF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap anywhere to wake display"
            android:textColor="#88FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Top HUD: TV URL & Connection Status -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#99000000">

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 TV Link: http://192.168.0.7:8080"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 Waiting for TV..."
            android:textColor="#FFD60A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_frosted_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnFlipCam"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_frosted_pill"
            android:gravity="center"
            android:text="🔄 Flip"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnTorch"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_frosted_pill"
            android:gravity="center"
            android:text="🔦 Light"
            android:textColor="#FFD60A"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnDim"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_frosted_pill"
            android:gravity="center"
            android:text="🌙 Dim"
            android:textColor="#00B0FF"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_frosted_pill"
            android:gravity="center"
            android:text="❌ Exit"
            android:textColor="#FF3B30"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
