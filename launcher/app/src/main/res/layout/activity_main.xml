<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B10"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Header: Clock & Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">

        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="#8E99B0"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Performance & Boost Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_stat_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRamStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ RAM: Calculating..."
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvStorageStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💾 Storage: Calculating..."
                android:textColor="#8E99B0"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBoost"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_boost_btn"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivBoostIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_boost"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvBoostText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOOST"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Controls 2x2 Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">

        <!-- Row 1: Wi-Fi & Bluetooth -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/toggleWifi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_wifi"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginEnd="6dp"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_wifi"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvWifiLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi"
                    android:textColor="#30D158"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toggleBt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_bluetooth"
                android:gravity="center"
                android:orientation="horizontal"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bluetooth"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvBtLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth"
                    android:textColor="#007AFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Flashlight & Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/toggleTorch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_torch"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginEnd="6dp"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_torch"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvTorchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flashlight"
                    android:textColor="#FFD60A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_settings"
                android:gravity="center"
                android:orientation="horizontal"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_settings"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#E5E5EA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- TV Cam Action Pill -->
    <LinearLayout
        android:id="@+id/btnTvCam"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pill_bluetooth"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📹 TV Webcam (Live Feed: 8080)"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_search_input"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="@string/search_hint"
        android:textColorHint="#5E6882"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="8dp" />

    <!-- 4-Column A-Z App Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never" />

    <!-- 4-App Bottom Dock (Gallery, Music, Browser, Camera) -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_dock_glass"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/dockGallery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/ivDockGallery"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_gallery" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/dockMusic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/ivDockMusic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/dockBrowser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/ivDockBrowser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_compass" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/dockCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/ivDockCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
